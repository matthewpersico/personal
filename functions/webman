# -*- sh -*-
# shellcheck shell=bash

# webman

# <Function Class: alias>
# <Function Justification: backgrounding>

webman ()
{
    if [[ $1 =~ ^-{1,2}h ]]; then
        bash-usage "${FUNCNAME[0]}" man "${FUNCNAME[0]}"
        { true; return; }
    else
        man -H  "$@" &
    fi
}
autotrack webman "$0"xb
:<<'__PODUSAGE__'
=head1 NAME

webman - run man -H in background mode, always.

=head1 DESCRIPTION

 webman opts and args
 webman -h|-help

This function exists just to force output to a browser and backgrounding. All
other behavior is the same.

=cut

__PODUSAGE__
