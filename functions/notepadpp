# -*- sh -*-
# shellcheck shell=bash

# notepadpp

# <Function Class: ???>
# <Function Justification: args>

notepadpp ()
{
    declare -a args=("$@")
    if [[ $1 =~ ^-+h ]]; then
        bash-usage notepadpp
        args=('--help')
    fi

    /mnt/c/Program\ Files/Notepad++/notepad++.exe "${args[@]}" &
}
autotrack notepadpp "$0"

# shellcheck disable=SC2317 #https://github.com/koalaman/shellcheck/wiki/SC2317
:<<'__PODUSAGE__'
=head1 NAME

notepadpp - start the notepad++ program

=head1 SYNOPSIS

 notepadpp options files
 notepadpp -h|--help

=head1 DESCRIPTION

Start the notepad++ Windows program from inside WSL. We use the function in
order to background the program and not tie up the terminal from which it is
started. We also avoid putting the program-specific path in PATH.

=cut

__PODUSAGE__
