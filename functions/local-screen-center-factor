# -*- sh -*-
# shellcheck shell=bash

# local-screen-center-factor

# <Function Class: X>
# <Function Justification: none>

local-screen-center-factor()
{
    case ${HOSTNAME,,} in
        monolith )
            if [[ $1 == 'x' ]]; then
                echo 4
                return;
            fi
            ;;
    esac

    ## all other machines are 2 iin both axis to get the center
    echo 2
}
autotrack local-screen-center-factor "$0"
:<<'__PODUSAGE__'
=head1 NAME

local-screen-center-factor - return adjustment factor for X server

=head1 SYNOPSIS

 local-screen-center-factor x|y

=head1 DESCRIPTION

Return the factor by which you adjust the center point of an X screen to
account for different size screens. In one paricular case, my MONOLITH server
that has a huge screen and a smaller laptop screen, but the X server treats
them as one. I want centering to take place on the one large physical screen
not across the virtual X display. Instead of dividing the x size of the display
by 2, we tweak it to center on the one screen.


=head1 ARGUMENTS

=over 4

=item x/y

Which axis factor to return.

=back

=cut

__PODUSAGE__
