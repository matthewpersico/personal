# -*- sh -*-
# shellcheck shell=bash

# git-claude - Init or resume a claude session in PWD

declare claude_session_name
claude_session_name=$(git repo id)

if claude -c; then
    cmd-echo --id git-claude "Found claude session '$claude_session_name'."
else
    cmd-echo --id git-claude "Starting new claude session '$claude_session_name'..."
    claude -n "$claude_session_name" -- /init
fi
