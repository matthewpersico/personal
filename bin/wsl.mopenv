# -*- sh -*-
# shellcheck shell=bash

# wsl.mopenv

## Items useful under WSL (Windows Subsystem for Linux)

winstrip ()
{
    echo "${1%"${1##*[![:space:]]}"}"
}

declare -a bb
mapfile -t bb < <(which brave-browser)
if [[ -f '/mnt/c/Program\ Files/BraveSoftware/Brave-Browser/Application/brave.exe' ]]; then
    bb+=('/mnt/c/Program\ Files/BraveSoftware/Brave-Browser/Application/brave.exe')
fi
set-browser "${bb[0]}"

# shellcheck disable=SC2016 #https://github.com/koalaman/shellcheck/wiki/SC2016
WIN_HOME="$(powershell.exe -NoProfile -Command '$env:USERPROFILE')"
WIN_HOME="$(dos2unix <<< "$WIN_HOME")"
export WIN_HOME
NIX_WIN_HOME="$(wslpath "$WIN_HOME")"
export NIX_WIN_HOME
if [ ! -L "$HOME/winhome" ]; then
    ln -s "$NIX_WIN_HOME" "$HOME/winhome"
fi

## Guard variable
WSLENV_LOADED=1
export WSLENV_LOADED
