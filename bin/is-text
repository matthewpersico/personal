# -*- sh -*-
# shellcheck shell=bash

# is-text - can I print a file to a terminal and not break the terminal?

declare verbose=1
if [[ $1 == -q ]]; then
    verbose=0
fi
declare f="$1"
if [[ ! -e "$f" ]]; then
    ((verbose)) && echo "not found" >&2
    false
elif file -bL --mime-encoding "$f" | grep -q '^binary$'; then
    ((verbose)) && echo "binary"
    false
else
    ((verbose)) && echo "text"
    true
fi
