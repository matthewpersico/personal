# -*- sh -*-
# shellcheck shell=bash

# ttyd - Run the ttyd program to put an ubuntu window in a browser tab.

if [[ $1 == '--kill' ]]; then
    psme | grep ttyd | grep -v grep
else
    declare port=7681
    cmd-echo --id ttyd "Ctrl+click http://localhost:$port/ to open in a browser.."
    ttyd.exe -W -w "$HOME" ubuntu run env INSIDE_TTYD=1 bash -l
fi
